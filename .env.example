NODE_ENV=development
HTTP_PORT=3001
WS_PORT=3002
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://architect:architect@localhost:5432/architect?schema=public
COOKIE_SIGNING_SECRET=replace-with-at-least-32-characters
OWNER_TOKEN_PEPPER=replace-with-at-least-32-characters

OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_AGENT_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_PROVIDER_TIMEOUT_MS=60000
AI_PROVIDER_MAX_RETRIES=1
AI_OUTPUT_REPAIR_ATTEMPTS=1

ENABLE_DEBUG_ROUTES=false
LOCALSTACK_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ALLOWED_REGIONS=us-east-1
AWS_STACK_PREFIX=architect
AWS_DEPLOY_ROLE_ARN=

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3002
