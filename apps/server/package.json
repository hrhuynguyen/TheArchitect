    "fastify": "^5.10.0",
    "lib0": "0.2.117",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@types/ws": "8.18.1",
    "prisma": "^6.19.3",
    "ws": "8.21.1"
  }
