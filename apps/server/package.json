{
  "name": "@architect/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "tsx src/cli/prisma.ts generate",
    "db:migrate": "tsx src/cli/prisma.ts migrate deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@architect/contracts": "*",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
